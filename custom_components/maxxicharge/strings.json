{
  "config": {
    "step": {
      "user": {
        "title": "Set up Maxxicharge",
        "description": "Looks for CCUs that announced themselves on the broker via MQTT autodiscovery. The MQTT integration must be set up.",
        "data": {
          "discovery_prefix": "Discovery prefix"
        },
        "data_description": {
          "discovery_prefix": "Default is “homeassistant”. Change only if your CCU uses another prefix."
        }
      },
      "select": {
        "title": "Select CCUs",
        "description": "CCUs found. Each CCU gets its own entry with tidy entities.",
        "data": {
          "ccus": "CCUs"
        }
      },
      "manual": {
        "title": "Enter CCU manually",
        "description": "No new CCU was found. Enter the CCU ID (format CCU2-XXXX-XXXX-XXXX). The CCU must have published its discovery config on the broker.",
        "data": {
          "ccu_id": "CCU ID",
          "ip": "CCU IP address (optional)"
        },
        "data_description": {
          "ip": "Used for the local endpoint http://<IP>/api/live and the device link."
        }
      }
    },
    "error": {
      "invalid_ccu_id": "Invalid CCU ID. Expected: CCU2-XXXX-XXXX-XXXX.",
      "cannot_connect": "No CCU answers at this IP (/api/live unreachable).",
      "not_found": "No discovery config for this CCU found on the broker.",
      "none_selected": "Please select at least one CCU."
    },
    "abort": {
      "mqtt_not_ready": "The MQTT integration is not set up or not connected.",
      "already_configured": "All CCUs found are already set up."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Maxxicharge options",
        "data": {
          "ip": "CCU IP address (optional)",
          "cleanup": "Old autodiscovery entities"
        },
        "data_description": {
          "ip": "Used for the local endpoint http://<IP>/api/live and the device link.",
          "cleanup": "Disables the duplicate entities from the CCU autodiscovery (nothing is deleted) or re-enables them."
        }
      }
    },
    "error": {
      "cannot_connect": "No CCU answers at this IP (/api/live unreachable)."
    }
  },
  "selector": {
    "cleanup": {
      "options": {
        "none": "Change nothing",
        "disable": "Disable old entities",
        "enable": "Re-enable old entities"
      }
    }
